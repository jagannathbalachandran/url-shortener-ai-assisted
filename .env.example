# Copy to .env to override local defaults. Never commit real secrets here.

# Defaults to a local SQLite file if unset.
# DATABASE_URL=sqlite:///./shortener.db

# To use the docker-compose Postgres service instead:
# DATABASE_URL=postgresql+psycopg://shortener:shortener@localhost:5432/shortener

# Public base URL used to build short links.
# BASE_URL=http://localhost:8000
